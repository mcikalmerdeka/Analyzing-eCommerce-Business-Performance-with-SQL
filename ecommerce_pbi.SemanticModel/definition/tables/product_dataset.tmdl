table Products

	column 'Product ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_id

	column 'Category Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_category_name

	column 'Photos Qty'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: product_photos_qty

	column 'Weight (g)'
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: product_weight_g

	column 'Length (cm)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: product_length_cm

	column 'Height (cm)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: product_height_cm

	column 'Width (cm)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: product_width_cm

	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("E:\Personal Projects\Analyzing eCommerce Business Performance with SQL\data\product_dataset.csv"),[Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    FirstColumn = Table.ColumnNames(#"Promoted Headers"){0},
				    #"Removed Unused" = Table.RemoveColumns(#"Promoted Headers", {FirstColumn, "product_name_lenght", "product_description_lenght"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Unused",{{"product_id", type text}, {"product_category_name", type text}, {"product_photos_qty", Int64.Type}, {"product_weight_g", Int64.Type}, {"product_length_cm", Int64.Type}, {"product_height_cm", Int64.Type}, {"product_width_cm", Int64.Type}}, "en-US"),
				    #"Replaced Null Category" = Table.ReplaceValue(#"Changed Type", null, "unknown", Replacer.ReplaceValue, {"product_category_name"})
				in
				    #"Replaced Null Category"
