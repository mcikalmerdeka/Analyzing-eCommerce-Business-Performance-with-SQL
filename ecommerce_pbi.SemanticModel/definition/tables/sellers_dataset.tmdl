table Sellers

	column 'Seller ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: seller_id

	column 'Zip Code Prefix'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: seller_zip_code_prefix

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: seller_city

	column 'State Code'
		dataType: string
		summarizeBy: none
		sourceColumn: seller_state

	partition Sellers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("E:\Personal Projects\Analyzing eCommerce Business Performance with SQL\data\sellers_dataset.csv"),[Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"seller_id", type text}, {"seller_zip_code_prefix", Int64.Type}, {"seller_city", type text}, {"seller_state", type text}}, "en-US")
				in
				    #"Changed Type"
