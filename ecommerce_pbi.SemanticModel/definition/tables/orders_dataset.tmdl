table Orders

	column 'Order ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: order_id

	column 'Customer Unique ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_unique_id

	column 'Order Status'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: order_status

	column 'Purchase Date'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: order_purchase_timestamp

	column 'Approved At'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: order_approved_at

	column 'Delivered to Carrier'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: order_delivered_carrier_date

	column 'Delivered to Customer'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: order_delivered_customer_date

	column 'Estimated Delivery'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: order_estimated_delivery_date

	column Status = SWITCH([Order Status], "delivered", "Delivered", "shipped", "Shipped", "canceled", "Canceled", "unavailable", "Unavailable", "invoiced", "Invoiced", "processing", "Processing", "created", "Created", "approved", "Approved", "Other")
		dataType: string
		summarizeBy: none

	column 'Delivery Days' = DATEDIFF([Purchase Date], [Delivered to Customer], DAY)
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column 'Delay Days' = IF(NOT ISBLANK([Delivered to Customer]), DATEDIFF([Estimated Delivery], [Delivered to Customer], DAY))
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column 'Is Late' = IF(NOT ISBLANK([Delivered to Customer]), IF([Delivered to Customer] > [Estimated Delivery], 1, 0))
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column 'Late Label' = SWITCH([Is Late], 1, "Late", 0, "On time", "Not delivered")
		dataType: string
		summarizeBy: none

	column 'Delivery Days Bucket Sort' = SWITCH(TRUE(), ISBLANK([Delivery Days]), 99, [Delivery Days] <= 3, 1, [Delivery Days] <= 7, 2, [Delivery Days] <= 14, 3, [Delivery Days] <= 21, 4, [Delivery Days] <= 30, 5, 6)
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column 'Delivery Days Bucket' = SWITCH(TRUE(), ISBLANK([Delivery Days]), "Not delivered", [Delivery Days] <= 3, "0-3 days", [Delivery Days] <= 7, "4-7 days", [Delivery Days] <= 14, "8-14 days", [Delivery Days] <= 21, "15-21 days", [Delivery Days] <= 30, "22-30 days", "30+ days")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Delivery Days Bucket Sort'

	partition Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("E:\Personal Projects\Analyzing eCommerce Business Performance with SQL\data\orders_dataset.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"order_id", type text}, {"customer_id", type text}, {"order_status", type text}, {"order_purchase_timestamp", type datetime}, {"order_approved_at", type datetime}, {"order_delivered_carrier_date", type datetime}, {"order_delivered_customer_date", type datetime}, {"order_estimated_delivery_date", type datetime}}, "en-US"),
				    #"Merged Customers" = Table.NestedJoin(#"Changed Type", {"customer_id"}, customers_dataset, {"customer_id"}, "customers", JoinKind.LeftOuter),
				    #"Expanded Customer Unique" = Table.ExpandTableColumn(#"Merged Customers", "customers", {"customer_unique_id"}, {"customer_unique_id"}),
				    #"Removed Customer Id" = Table.RemoveColumns(#"Expanded Customer Unique", {"customer_id"}),
				    #"Filtered Window" = Table.SelectRows(#"Removed Customer Id", each [order_purchase_timestamp] <= #datetime(2018, 8, 31, 23, 59, 59))
				in
				    #"Filtered Window"
