table Reviews

	column 'Review ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: review_id

	column 'Order ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: order_id

	column 'Review Score'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: review_score

	column 'Comment Title'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: review_comment_title

	column 'Comment Message'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: review_comment_message

	column 'Review Creation Date'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: review_creation_date

	column 'Review Answer Timestamp'
		dataType: dateTime
		formatString: General Date
		isHidden
		summarizeBy: none
		sourceColumn: review_answer_timestamp

	column 'Sentiment Sort' = SWITCH(TRUE(), [Review Score] >= 4, 1, [Review Score] = 3, 2, 3)
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column Sentiment = SWITCH(TRUE(), [Review Score] >= 4, "Positive", [Review Score] = 3, "Neutral", "Negative")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Sentiment Sort'

	partition Reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("E:\Personal Projects\Analyzing eCommerce Business Performance with SQL\data\order_reviews_dataset.csv"),[Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"review_id", type text}, {"order_id", type text}, {"review_score", Int64.Type}, {"review_comment_title", type text}, {"review_comment_message", type text}, {"review_creation_date", type datetime}, {"review_answer_timestamp", type datetime}}, "en-US"),
				    #"Merged Orders" = Table.NestedJoin(#"Changed Type", {"order_id"}, Orders, {"order_id"}, "orders", JoinKind.Inner),
				    #"Removed Orders" = Table.RemoveColumns(#"Merged Orders", {"orders"}),
				    #"Sorted Latest" = Table.Sort(#"Removed Orders", {{"review_answer_timestamp", Order.Descending}}),
				    #"Deduplicated" = Table.Distinct(#"Sorted Latest", {"order_id"})
				in
				    #"Deduplicated"
